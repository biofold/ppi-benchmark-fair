cff-version: 1.2.0
message: "If you use this dataset or its FAIR metadata, please cite both the original publication (Schweke et al. 2023) and this metadata package."
title: "ELIXIR 3D-BioInfo Benchmark for Protein-Protein Interfaces: FAIR Metadata"
abstract: >-
  FAIR metadata (Schema.org, Bioschemas and MLCommons Croissant) for the ELIXIR 3D-BioInfo benchmark of 1,677 homodimer interfaces
  from 1,645 protein crystal structures, with the structure files, an in-repo snapshot of the PDB metadata and the documentation of
  the label curation. The benchmark was published by Schweke et al. (2023, doi:10.1002/pmic.202200323); this package uses the curated
  annotation file of the benchmark authors (844 physiological and 833 non-physiological interfaces instead of the published 836 and 841).
type: dataset
authors:
  - family-names: "Capriotti"
    given-names: "Emidio"
    orcid: "https://orcid.org/0000-0002-2323-0963"
    affiliation: "University of Bologna"
  - family-names: "Martelli"
    given-names: "Pier Luigi"
    orcid: "https://orcid.org/0000-0002-0274-5669"
    affiliation: "University of Bologna"
  - family-names: "Savojardo"
    given-names: "Castrense"
    orcid: "https://orcid.org/0000-0002-7359-0633"
    affiliation: "University of Bologna"
version: "1.0.0"
license: CC-BY-NC-4.0
repository-code: "https://github.com/biofold/ppi-benchmark-fair"
url: "https://biofold.github.io/ppi-benchmark-fair"
keywords:
  - "protein-protein interaction"
  - "structural bioinformatics"
  - "machine learning"
  - "benchmark dataset"
  - "FAIR data"
  - "Bioschemas"
  - "Croissant"
  - "homodimer interfaces"

